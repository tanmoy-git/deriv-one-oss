# Platform — backend configuration
#
# Copy to backend/.env and edit. Everything here has a working default except
# the two marked REQUIRED, so a development instance starts with almost nothing
# set. Defaults are chosen to be safe rather than convenient: local storage,
# no unsandboxed execution, production-shaped naming.

# ─────────────────────────────────────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────────────────────────────────────

# Deployment environment. Anything other than "production" suffixes externally
# named resources, so several environments can share one backing store without
# ever resolving each other's data.
APP_ENV=development

# Prefix for every externally named resource this deployment owns (secrets,
# buckets, indexes). Change it when two deployments share a backing account.
RESOURCE_PREFIX=platform

# White-label branding (defaults ship as Platform).
# APP_NAME=Platform
# APP_SHORT_NAME=Platform
# APP_LOGO_URL=/app-logo-icon.svg
# ORG_NOUN=employee
# BRAND_COLOR=#FF444F
# BRAND_COLOR_HOVER=#e03d47
# BRAND_COLOR_SOFT=#FFF0F0

# Public base URL of this deployment. Used for OAuth callbacks and for links in
# notifications, so it must be reachable by the people receiving them.
#
# For Slack and Google integrations specifically, this also has to be
# reachable by Slack's and Google's servers, not just your users — so a bare
# http://localhost:8080 only works if you tunnel it (e.g. `ngrok http 8080` or
# `cloudflared tunnel --url http://localhost:8080`) and set this to the
# tunnel's HTTPS URL instead. See README.md#callback-and-request-urls for the
# exact endpoints each integration calls back to.
APP_BASE_URL=http://localhost:8080

# Base URL reachable from sandbox containers for agent-to-agent calls.
# Defaults to APP_BASE_URL. Legacy alias: DERIV_ONE_BASE_URL.
# PLATFORM_INTERNAL_BASE_URL=http://backend:8000

# HS256 secret for /internal/* service tokens (Slack relay, agent invoke).
# Required when exposing internal routes on a private network.
# INTERNAL_SIGNING_SECRET=

# Optional: front the Slack events endpoint with a separate gateway service —
# a relay/queue sitting between Slack and this backend, useful once you are
# running more than one replica. Not needed for a single instance, and no such
# gateway ships in this repository; you would build and deploy your own.
# When set, generated Slack app manifests use {SLACK_EVENTS_GATEWAY_URL}/slack/agent/{app_id}
# as the Request URL instead of {APP_BASE_URL}/api/slack/events.
# SLACK_EVENTS_GATEWAY_URL=

# Database. Defaults to a local SQLite file; point at PostgreSQL for anything
# with more than one replica.
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/platform
# HUB_DATABASE_PATH=/data/hub.db
# PostgreSQL connection pool, per process (API replica, worker, scheduler).
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_POOL_TIMEOUT=30

# ─────────────────────────────────────────────────────────────────────────────
# Model gateway  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. The model picker is populated from whatever
# this endpoint reports, so the available models are a property of your gateway
# and not of this application.
#
# Note the host: under `docker compose`, `localhost` is the backend container
# itself, not your machine. A gateway running on your machine is reached at
# host.docker.internal (Docker Desktop) or 172.17.0.1 (Linux). Use a real
# hostname for a gateway that is not local.
MODEL_GATEWAY_URL=http://host.docker.internal:4000
MODEL_GATEWAY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────────────────────────────────────
# Any OIDC provider that can put a verifiable JWT in front of this application.
# OIDC_ISSUER (or legacy TEAM_DOMAIN) is the JWT issuer; POLICY_AUD is required.
OIDC_ISSUER=https://your-issuer.example.com
TEAM_DOMAIN=https://your-issuer.example.com
POLICY_AUD=

# JWKS URL for signature verification. When unset, the app tries OIDC discovery
# at {OIDC_ISSUER}/.well-known/openid-configuration, then Cloudflare Access
# certs as a fallback when the issuer looks like Cloudflare Access.
# OIDC_JWKS_URL=https://your-issuer.example.com/.well-known/jwks.json

# When true, any valid JWT receives at least member access even without groups.
# AUTH_OPEN_MEMBERSHIP=false

# Where your provider puts group membership. Both top-level claims and claims
# nested under `custom` are checked.
# GROUPS_JWT_CLAIM_KEYS=groups,roles

# Role mapping. Group names are matched case-insensitively.
ADMIN_GROUPS=platform-admins
MEMBER_GROUPS=platform-users
# READONLY_GROUPS=platform-observers

# Bootstrap administrators by address, for before any groups are wired up.
# A way in, not a permission model — move to groups once you have them.
# ADMIN_EMAILS=you@example.org

# When false (the default), any authenticated caller is at least a member. Set
# true once your provider actually emits groups; it is the stricter posture.
REQUIRE_GROUP_MEMBERSHIP=false

# Development only: skip token verification entirely and act as a fixed user.
# On here so that `docker compose up` gives you a working UI before you have an
# identity provider — the TEAM_DOMAIN above is a placeholder, and with mock auth
# off every request would be rejected against it. Turn this off the moment this
# deployment is reachable by anyone but you; it is the whole authentication
# check, and with it on, anyone who can reach the port is MOCK_USER_EMAIL.
ENABLE_MOCK_AUTH=true
MOCK_USER_EMAIL=dev@localhost.local
MOCK_USER_GROUPS=platform-admins,platform-users
MOCK_USER_SUB=mock-subject

# Expose the OpenAPI schema without a token. Normally false.
PUBLIC_OPENAPI=false

# ─────────────────────────────────────────────────────────────────────────────
# Providers
# ─────────────────────────────────────────────────────────────────────────────
# Each accepts a built-in name or a dotted path to your own implementation,
# e.g. BLOB_STORE=acme.providers:ManagedBlobs

# Where files live. Skills, generated apps, run artefacts, agent memory and
# knowledge-base documents all go here, each under its own key prefix.
BLOB_STORE=local
BLOB_ROOT=var/blobs
# Secret for signing time-limited download links. Without it, links are not
# minted at all and files are streamed through the application instead.
BLOB_URL_SECRET=

# Where credential material lives. The database only ever stores references.
SECRET_BACKEND=local
SECRET_ROOT=var/secrets
# REQUIRED for the local backend: 32 bytes, base64. Generate with
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key means losing every stored credential.
SECRET_ENCRYPTION_KEY=

# What runs model-generated code. "container" gives one disposable container per
# run; "subprocess" gives no isolation at all and refuses to start without the
# explicit opt-in below.
#
# What "container" is worth, stated plainly: one throwaway container per run,
# network off, memory and CPU capped, read-only root filesystem, all
# capabilities dropped, no-new-privileges, no credentials mounted, and a fresh
# workspace each time. It is ordinary container isolation — the kernel is shared
# with the host, so a kernel-level escape is not defended against. That is the
# default because it is what every host already has.
SANDBOX_PROVIDER=container
CONTAINER_ENGINE=docker

# A stronger runtime, if the host has one installed — gVisor (runsc) or Kata,
# which put a kernel boundary between a run and the host. Neither ships here and
# neither is set up by `docker compose`; you install and register it with your
# engine yourself. Worth doing before running untrusted code from people who are
# not you.
# SANDBOX_RUNTIME=runsc

# The image a run gets. A run has no network, so whatever it needs must already
# be in the image — and SANDBOX_PYTHON_PACKAGES must say what that is, because
# that list is what the model is told it can import. `docker compose` builds
# docker/sandbox/Dockerfile and sets both. Bare python:3.12-slim is the fallback
# and has the standard library only.
# SANDBOX_PYTHON_IMAGE=platform/sandbox-python:latest
# SANDBOX_PYTHON_PACKAGES=requests, httpx, pandas, numpy, openpyxl
# SANDBOX_NODE_IMAGE=node:22-slim

# Where run workspaces are staged. Needed when this process is itself in a
# container driving the host's engine: the engine resolves mount paths in its
# own filesystem, so a directory that exists only in this container would mount
# empty and every run would fail to find its code. Set this to a directory that
# is mounted in from the engine's host; the host-side name is read back from the
# engine, so it does not also have to be configured.
# SANDBOX_WORKSPACE_ROOT=/sandbox-workspaces
# SANDBOX_HOST_WORKSPACE_ROOT=
# Set when this container runs its own engine, so both paths already agree.
# SANDBOX_ALLOW_UNSHARED_WORKSPACE=0

# Runs execute as this process's own uid/gid so that what they write can be read
# back and cleaned up. "off" leaves the image's user, which means root-owned
# output the application may not be able to delete.
# SANDBOX_RUN_AS_USER=

# ALLOW_UNSANDBOXED_EXECUTION=0

# Who the people in the organisation are. "claims" derives everything from the
# caller's own token and knows no reporting lines, so approvals route to
# administrators. "file" reads data/directory.yaml.
DIRECTORY_PROVIDER=claims
# DIRECTORY_FILE=data/directory.yaml

# What answers a knowledge-base search.
RETRIEVAL_PROVIDER=local
RETRIEVAL_ROOT=var/retrieval

# What carries work to background workers. The in-process queue is lost on
# restart, which is fine for a single node and not fine for more than one.
MESSAGE_QUEUE=inprocess
# Topic the Slack consumer and warm worker read from.
# SLACK_EVENTS_TOPIC=slack.events

# Where operational alerts go.
ALERT_SINK=log
# ALERT_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Optional integrations
# ─────────────────────────────────────────────────────────────────────────────

# Connected-system catalogue. Absent means skill/system linking does nothing.
# SYSTEM_CATALOG_FILE=data/systems.yaml

# Mirror the skill catalogue and generated apps to the blob store. Turn off only
# on a single node whose disk is already durable.
# SKILLS_STORE_ENABLED=1
# APPS_STORE_ENABLED=1

# Environment variable names stripped from every agent subprocess, on top of the
# built-in list. Use for your own platform credentials.
# DENIED_SUBPROCESS_ENV=MY_PLATFORM_TOKEN,ANOTHER_SECRET

# People who bypass per-skill access control entirely. Empty by default, and a
# deliberate choice to populate — this is a standing bypass, not a convenience.
# SUPER_ACCESS_EMAILS=

# How long a dispatch may hold its dedup claim before another worker may retry.
# LEASE_REFRESH_INTERVAL=45

# Per-skill tool-turn overrides, for skills that genuinely need more.
# SKILL_TOOL_TURN_OVERRIDES=deep-research=80

# Skill access-control manifest.
# SKILLS_ACL_MANIFEST=src/data/skills-acl.yaml

# Departments counted in the active-user denominator. Unset means everyone.
# ROLLOUT_DEPARTMENTS=Engineering,Support

# Slack. Only needed if you register Slack agents; see docs/ADOPTER_GUIDE.md.
#
# Optional org-admin App Configuration tokens for auto-creating Slack apps.
# When unset, use the manual/guided manifest path only.
# SLACK_APP_CONFIGURATION_ACCESS_TOKEN=
# SLACK_APP_CONFIGURATION_REFRESH_TOKEN=
#
# Slack user that must be added as a collaborator on self-created apps when
# manifest sync is enabled (required for auto-create / guided sync).
# SLACK_CONFIG_COLLABORATOR=platform-bot
#
# Comma-separated egress CIDRs appended to Slack app IP allowlists when present.
# SLACK_MANIFEST_IP_ALLOWLIST=
#
# SLACK_WORKSPACE_TOKEN=

# Lets a signed-in user connect their own Slack account (separate from an
# agent's bot token). Only needed if you enable that per-user integration.
# SLACK_USER_INTEGRATION_CLIENT_ID=
# SLACK_USER_INTEGRATION_CLIENT_SECRET=

# Admin → Infrastructure tab (Kubernetes metrics). auto | on | off
# INFRA_MONITORING_ENABLED=auto
# INFRA_WORKLOAD_ALLOWLIST=backend,frontend,slack-consumer,scheduler
