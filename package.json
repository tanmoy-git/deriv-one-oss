    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && tsc --noEmit -p tsconfig.features.json",
    "test": "vitest run",
    "api:types": "mkdir -p node_modules/.cache && ${PYTHON:-backend/.venv/bin/python} backend/export_openapi.py node_modules/.cache/openapi.json && openapi-typescript node_modules/.cache/openapi.json -o src/api/schema.d.ts"
  },
